# Copy to .env for local development. Never commit real keys.
# Vite exposes only VITE_-prefixed variables to the browser; everything else is server-only.

# Supabase (browser-safe; RLS-guarded)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Stripe — server only (Vercel → Project → Settings → Environment Variables).
STRIPE_SECRET_KEY=sk_test_...
# Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: currency for Checkout (default aud)
STRIPE_CURRENCY=aud

# Supabase service role — server only; the webhook and admin capture write with it.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Where Stripe returns the customer after paying. Leave blank to use the host the
# request came in on, which is right for every deployment including previews.
# Set it only to pin one origin — and then it must be the live site, or paying
# customers are returned to whatever is named here.
SITE_URL=

# Australia Post — server only. Postage rates at checkout.
# PAC key from https://developers.auspost.com.au (Postage Assessment Calculator).
AUSPOST_PAC_KEY=
# The postcode you post from, e.g. 6000
AUSPOST_FROM_POSTCODE=

# Anthropic — server only (concierge, AI conception, marketing drafts).
ANTHROPIC_API_KEY=sk-ant-...

# Mailgun — server only. Transactional mail sent by the app itself.
# Supabase's own auth mail (confirm, reset, magic link) does NOT read these: it
# is configured separately, as SMTP, in the Supabase dashboard — see
# docs/SUPABASE_SETUP.md. Both should point at the same Mailgun domain so every
# message the customer receives comes from the same sender.
# Private API key: Mailgun → Account → API keys.
MAILGUN_API_KEY=
# The sending domain exactly as Mailgun lists it, e.g. mg.kilaubali.com
MAILGUN_DOMAIN=
# Mailgun's API host for the region the domain was created in. US (default):
# https://api.mailgun.net — EU: https://api.eu.mailgun.net. A domain created in
# one region is not reachable from the other.
MAILGUN_API_BASE=https://api.mailgun.net
# From: header on app mail, e.g. "Kilau Bali <no-reply@mg.kilaubali.com>"
MAILGUN_FROM=

# Sender block printed on staff shipping labels. Lines separated by "|":
#   VITE_RETURN_ADDRESS=Kilau Bali|PO Box 000, Suburb QLD 4000
VITE_RETURN_ADDRESS=

# Publish verified customer-support details and approved policy pages before launch.
VITE_SUPPORT_EMAIL=
VITE_PRIVACY_POLICY_URL=
VITE_RETURNS_POLICY_URL=

# ─── Dropshipping (AliDrop) — server only ────────────────────────────────────
# AliDrop ships as an app for Shopify, WooCommerce and Wix; it publishes no
# developer API for a custom storefront. So the hand-off works in two stages:
#
#   1. Nothing set below → every paid order with a dropshipped line is queued
#      in `supplier_orders`. Admin Console → Dropship exports it as CSV to
#      upload or paste into AliDrop, then mark each order off. This works today.
#
#   2. The moment you have an endpoint and a key — from AliDrop, or from any
#      other supplier — fill these in and the same queue posts itself as orders
#      are paid, with anything that fails retried from the same screen.
#
# Nothing here is guessed: the request is assembled entirely from these values.
SUPPLIER_NAME=alidrop
# e.g. https://api.example-supplier.com/v1  (no trailing slash needed)
SUPPLIER_API_BASE=
# Path appended to the base to create an order, e.g. /orders
SUPPLIER_ORDER_PATH=
SUPPLIER_API_KEY=
# Header and scheme the key is sent under. Defaults suit a bearer token;
# a supplier wanting `X-API-Key: abc123` takes SUPPLIER_AUTH_HEADER=X-API-Key
# and an empty SUPPLIER_AUTH_SCHEME.
SUPPLIER_AUTH_HEADER=Authorization
SUPPLIER_AUTH_SCHEME=Bearer
SUPPLIER_ORDER_METHOD=POST
# Dotted path to the supplier's own order id in the response, e.g. data.id
SUPPLIER_ORDER_ID_FIELD=id
# Set to 1 while testing: orders are queued and exportable but never posted.
SUPPLIER_DRY_RUN=
